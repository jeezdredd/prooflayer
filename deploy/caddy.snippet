# Caddy snippet for ProofLayer.
# Cloudflare Tunnel forwards public traffic to Caddy at http://localhost:80.
# TLS termination happens at Cloudflare edge - we serve plain HTTP locally.

# ===== Frontend (SPA, nginx in container) =====
http://prooflayer.cloud {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080
    log {
        output file /var/log/caddy/prooflayer-fe.log
        format json
    }
}

# ===== Backend API =====
http://api.prooflayer.cloud {
    encode zstd gzip

    reverse_proxy 127.0.0.1:8000 {
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
    }

    log {
        output file /var/log/caddy/prooflayer-api.log
        format json
    }
}

# ===== Media (MinIO, private bucket, presigned URLs) =====
# The backend signs URLs against https://media.prooflayer.cloud with path-style keys
# (/prooflayer-media/<key>?X-Amz-...). SigV4 covers host and path, so: do NOT rewrite a path
# that already carries the bucket, and pass the original Host header through to MinIO.
# Bare legacy paths (/<key>) still get the bucket prefixed; they only work while unsigned.
http://media.prooflayer.cloud {
    encode zstd gzip
    @bare not path /prooflayer-media/*
    rewrite @bare /prooflayer-media{path}
    reverse_proxy 127.0.0.1:9000
}

# ===== Django Admin =====
http://admin.prooflayer.cloud {
    encode zstd gzip
    redir / /admin/ 301
    reverse_proxy 127.0.0.1:8000 {
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
    }
}

# ===== Flower (Celery monitor) =====
http://flower.prooflayer.cloud {
    basic_auth {
        seb0107 $2a$14$PsfqneOWJlDVlyDlXMWwfe86O/IedTtpjiVA3klHdPRLIubgAPF/e
    }
    reverse_proxy 127.0.0.1:5555
}
