[Unit]
Description=ProofLayer GPU thermal guard (fan curve + pause Ollama when the GPU runs hot)
After=docker.service
Wants=docker.service

[Service]
ExecStart=/usr/local/bin/prooflayer-gpu-guard
ExecStopPost=-/usr/bin/docker unpause deploy-ollama-1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
